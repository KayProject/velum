# Velum — environment.
#
# Two rules this file exists to enforce:
#   1. Nothing here that starts with NEXT_PUBLIC_ may ever hold a signing key. NEXT_PUBLIC_ is
#      compiled into the browser bundle; putting a key there publishes it.
#   2. Mainnet and Sepolia values are never mixed. VELUM_NETWORK picks one set; lib/env.ts refuses
#      to start if the set is half-filled.

# "mainnet" | "sepolia"
VELUM_NETWORK=mainnet

# --- mainnet -----------------------------------------------------------------------------------
# The prover and discovery hosts are not in any StarkWare doc; they were read out of
# starkware-industries/pripay server.js:19-26 and probed live on 2026-08-26. See docs/SPIKE.md.
MAINNET_NODE_URL=https://rpc.starknet.lava.build
MAINNET_PROVING_SERVICE_URL=https://transaction-prover.alpha-mainnet.sw-dev.io
MAINNET_DISCOVERY_URL=https://discovery-service.alpha-mainnet.sw-dev.io
MAINNET_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
MAINNET_SHADOW_ACCOUNT_ANONYMIZER_ADDRESS=
MAINNET_VELUM_ADDRESS=

# --- sepolia -----------------------------------------------------------------------------------
SEPOLIA_NODE_URL=https://rpc.starknet-testnet.lava.build
SEPOLIA_PROVING_SERVICE_URL=https://transaction-prover.alpha-sepolia.sw-dev.io
SEPOLIA_DISCOVERY_URL=https://discovery-service.alpha-sepolia.sw-dev.io
SEPOLIA_POOL_ADDRESS=
SEPOLIA_SHADOW_ACCOUNT_ANONYMIZER_ADDRESS=
SEPOLIA_VELUM_ADDRESS=

# --- server only -------------------------------------------------------------------------------
# The relayer fires redeem() when a verifier first reads a valid claim, so the verifier never needs
# a wallet. Server-side only. If this ever appears as NEXT_PUBLIC_ANYTHING, the build is wrong.
VELUM_RELAYER_ADDRESS=
VELUM_RELAYER_PRIVATE_KEY=

# --- browser-safe ------------------------------------------------------------------------------
# Only the two values a verifier's browser genuinely needs, and neither is a secret.
NEXT_PUBLIC_VELUM_NETWORK=mainnet
NEXT_PUBLIC_VELUM_ADDRESS=

# Jadon's network breaks TLS to https RPCs (rustls BadRecordMac). Point everything at the local
# Python proxy when that bites, rather than debugging the code.
# MAINNET_NODE_URL=http://127.0.0.1:8547
